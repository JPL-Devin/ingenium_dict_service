{
  "name": "dict-service",
  "version": "1.0.0",
  "description": "REST API service for managing aerospace project dictionaries, telemetry channels, commands, EVRs, and verification scripts. Built with Fastify and ArangoDB.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node ./src/app.js",
    "dev": "nodemon ./src/app.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --forceExit --detectOpenHandles"
  },
  "repository": {
    "url": "https://github.com/OpenIngenium/dict-service.git",
    "type": "git"
  },
  "keywords": [
    "aerospace",
    "telemetry",
    "dictionary",
    "api",
    "fastify",
    "arangodb",
    "rest",
    "commands",
    "evr",
    "verification",
    "spacecraft"
  ],
  "author": "OpenIngenium",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/OpenIngenium/dict-service/issues"
  },
  "homepage": "https://github.com/OpenIngenium/dict-service#readme",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "arangojs": "^10.2.2",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14"
  }
}
